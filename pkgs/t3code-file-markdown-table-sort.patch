+import { createElement } from "react";
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  markdownNodeText,
+  nextMarkdownTableSort,
+  parseMarkdownCellNumber,
+  sortMarkdownTableRowIndices,
+} from "./markdownTableSort";
+
+describe("parseMarkdownCellNumber", () => {
+  it("reads numbers with thousands separators, units and signs", () => {
+    expect(parseMarkdownCellNumber("1,234")).toBe(1234);
+    expect(parseMarkdownCellNumber("¥12,000")).toBe(12000);
+    expect(parseMarkdownCellNumber("$1,234.50")).toBe(1234.5);
+    expect(parseMarkdownCellNumber("-3,000 円")).toBe(-3000);
+    expect(parseMarkdownCellNumber("−2.5")).toBe(-2.5);
+    expect(parseMarkdownCellNumber("▲500")).toBe(-500);
+    expect(parseMarkdownCellNumber("12.5%")).toBe(12.5);
+    expect(parseMarkdownCellNumber("１，２００")).toBe(1200);
+    expect(parseMarkdownCellNumber("CA$1,800/月")).toBe(1800);
+  });
+
+  it("leaves dates, versions and words as text", () => {
+    expect(parseMarkdownCellNumber("2026-11-08")).toBeNull();
+    expect(parseMarkdownCellNumber("1.2.3")).toBeNull();
+    expect(parseMarkdownCellNumber("10:30")).toBeNull();
+    expect(parseMarkdownCellNumber("Toronto")).toBeNull();
+    expect(parseMarkdownCellNumber("")).toBeNull();
+  });
+});
+
+describe("sortMarkdownTableRowIndices", () => {
+  it("sorts numbers by value, not by their characters", () => {
+    expect(sortMarkdownTableRowIndices(["1,000", "200", "30", "4,000,000"], "ascending")).toEqual([
+      2, 1, 0, 3,
+    ]);
+    expect(sortMarkdownTableRowIndices(["1,000", "200", "30"], "descending")).toEqual([0, 1, 2]);
+  });
+
+  it("puts numbers before text and empty cells last in both directions", () => {
+    expect(sortMarkdownTableRowIndices(["b", "", "10", "a", "2"], "ascending")).toEqual([
+      4, 2, 3, 0, 1,
+    ]);
+    expect(sortMarkdownTableRowIndices(["b", "", "10", "a", "2"], "descending")).toEqual([
+      0, 3, 2, 4, 1,
+    ]);
+  });
+
+  it("keeps the source order of equal cells", () => {
+    expect(sortMarkdownTableRowIndices(["x", "y", "x"], "ascending")).toEqual([0, 2, 1]);
+    expect(sortMarkdownTableRowIndices(["x", "y", "x"], "descending")).toEqual([1, 0, 2]);
+  });
+
+  it("orders text with embedded numbers naturally", () => {
+    expect(
+      sortMarkdownTableRowIndices(["10:30", "9:15", "2026-11-08", "2026-01-31"], "ascending"),
+    ).toEqual([1, 0, 3, 2]);
+  });
+});
+
+describe("nextMarkdownTableSort", () => {
+  it("cycles ascending, descending and unsorted on one column", () => {
+    const ascending = nextMarkdownTableSort(null, 1);
+    expect(ascending).toEqual({ column: 1, direction: "ascending" });
+    const descending = nextMarkdownTableSort(ascending, 1);
+    expect(descending).toEqual({ column: 1, direction: "descending" });
+    expect(nextMarkdownTableSort(descending, 1)).toBeNull();
+    expect(nextMarkdownTableSort(descending, 2)).toEqual({ column: 2, direction: "ascending" });
+  });
+});
+
+describe("markdownNodeText", () => {
+  it("joins the text of nested elements", () => {
+    const node = createElement("span", null, "¥", createElement("strong", null, "1,200"), " 円");
+    expect(markdownNodeText(node)).toBe("¥1,200 円");
+  });
+});
diff --git a/apps/web/src/components/chat/markdownTableSort.ts b/apps/web/src/components/chat/markdownTableSort.ts
new file mode 100644
index 00000000..74bca79a
--- /dev/null
+++ b/apps/web/src/components/chat/markdownTableSort.ts
@@ -0,0 +1,68 @@
+import { isValidElement, type ReactNode } from "react";
+
+export type MarkdownTableSortDirection = "ascending" | "descending";
+
+export interface MarkdownTableSort {
+  readonly column: number;
+  readonly direction: MarkdownTableSortDirection;
+}
+
+const NUMERIC_CELL = /^(\D{0,4}?)([-+−▲]?)(\D{0,4}?)(\d+(?:\.\d+)?|\.\d+)(\D{0,8})$/u;
+const NEGATIVE_SIGNS = new Set(["-", "−", "▲"]);
+const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: "base" });
+
+export function markdownNodeText(node: ReactNode): string {
+  if (node === null || node === undefined || typeof node === "boolean") return "";
+  if (typeof node === "string" || typeof node === "number") return String(node);
+  if (Array.isArray(node)) return node.map(markdownNodeText).join("");
+  if (isValidElement(node)) {
+    return markdownNodeText((node.props as { children?: ReactNode }).children);
+  }
+  return "";
+}
+
+export function parseMarkdownCellNumber(text: string): number | null {
+  const compact = text.normalize("NFKC").replace(/[\s,]/gu, "");
+  const match = NUMERIC_CELL.exec(compact);
+  if (!match) return null;
+  const [, , sign = "", , digits = ""] = match;
+  const value = Number(digits);
+  if (!Number.isFinite(value)) return null;
+  return NEGATIVE_SIGNS.has(sign) ? -value : value;
+}
+
+function compareCellTexts(left: string, right: string): number {
+  const leftNumber = parseMarkdownCellNumber(left);
+  const rightNumber = parseMarkdownCellNumber(right);
+  if (leftNumber !== null && rightNumber !== null) return leftNumber - rightNumber;
+  if (leftNumber !== null) return -1;
+  if (rightNumber !== null) return 1;
+  return collator.compare(left, right);
+}
+
+export function sortMarkdownTableRowIndices(
+  cellTexts: readonly string[],
+  direction: MarkdownTableSortDirection,
+): number[] {
+  const factor = direction === "ascending" ? 1 : -1;
+  const texts = cellTexts.map((text) => text.trim());
+  return texts
+    .map((_, index) => index)
+    .sort((leftIndex, rightIndex) => {
+      const left = texts[leftIndex] ?? "";
+      const right = texts[rightIndex] ?? "";
+      if (left === "" || right === "") {
+        if (left === right) return leftIndex - rightIndex;
+        return left === "" ? 1 : -1;
+      }
+      return factor * compareCellTexts(left, right) || leftIndex - rightIndex;
+    });
+}
+
+export function nextMarkdownTableSort(
+  current: MarkdownTableSort | null,
+  column: number,
+): MarkdownTableSort | null {
+  if (current?.column !== column) return { column, direction: "ascending" };
+  return current.direction === "ascending" ? { column, direction: "descending" } : null;
+}
