+export function isSidebarThreadAwaitingUser(
+  thread: ThreadStatusInput & SidebarThreadStatusInput,
+): boolean {
+  const status = resolveSidebarThreadStatus(thread);
+  return status === "input" || (status === "ready" && hasUnseenCompletion(thread));
+}
+
+export function resolveAdjacentDoneThreadId<T>(input: {
+  threadIds: readonly T[];
+  currentThreadId: T | null;
+  direction: ThreadTraversalDirection;
+  isDone: (threadId: T) => boolean;
+}): T | null {
+  const { currentThreadId, direction, isDone, threadIds } = input;
+  const count = threadIds.length;
+  if (count === 0) {
+    return null;
+  }
+  const step = direction === "next" ? 1 : -1;
+  const currentIndex = currentThreadId === null ? -1 : threadIds.indexOf(currentThreadId);
+  const startIndex = currentIndex !== -1 ? currentIndex : direction === "next" ? -1 : count;
+  for (let offset = 1; offset <= count; offset += 1) {
+    const index = (((startIndex + step * offset) % count) + count) % count;
+    const threadId = threadIds[index];
+    if (threadId !== undefined && threadId !== currentThreadId && isDone(threadId)) {
+      return threadId;
+    }
+  }
+  return null;
+}
+
 export type SidebarThreadStatus =
   | "approval"
   | "input"
