+const readConsoleSession = (databasePath: string) =>
+  Effect.try(() => {
+    const database = new NodeSqlite.DatabaseSync(databasePath, { readOnly: true });
+    try {
+      database.exec("PRAGMA busy_timeout = 100");
+      const row = database
+        .prepare(
+          `SELECT value FROM credential
+           WHERE integration_id = 'opencode' AND active IS NOT 0
+           ORDER BY active DESC, time_created DESC, id DESC LIMIT 1`,
+        )
+        .get();
+      const session =
+        typeof row?.value === "string"
+          ? Option.getOrUndefined(decodeConsoleSession(row.value))
+          : undefined;
+      if (!session) return undefined;
+      if (typeof session.expires === "number" && session.expires <= Date.now()) return undefined;
+      const url = new URL(session.metadata.server);
+      if (`${url.origin}${url.pathname.replace(/\/+$/, "")}` !== OPENCODE_CONSOLE) return undefined;
+      return { access: session.access.trim(), orgId: session.metadata.orgID };
+    } finally {
+      database.close();
+    }
+  }).pipe(Effect.orElseSucceed(() => undefined));
+
+const consoleMeterPercent = (meter: typeof ConsoleMeter.Type) => {
+  const limit = Number(meter.limitMicroCents);
+  return clampPercent(limit > 0 ? (Number(meter.usedMicroCents) / limit) * 100 : 0);
+};
+
+const consoleMeterReset = (meter: typeof ConsoleMeter.Type) =>
+  meter.resetsAt ? { resetsAt: meter.resetsAt } : {};
