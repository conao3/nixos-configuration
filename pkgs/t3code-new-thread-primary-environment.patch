+export function preferPrimaryEnvironmentProjectRef(projectRef: ScopedProjectRef): ScopedProjectRef {
+  const primaryEnvironmentId = readPrimaryEnvironmentId();
+  if (primaryEnvironmentId === null || projectRef.environmentId === primaryEnvironmentId) {
+    return projectRef;
+  }
+  const projects = readProjects();
+  const source = projects.find(
+    (project) =>
+      project.environmentId === projectRef.environmentId && project.id === projectRef.projectId,
+  );
+  if (!source) {
+    return projectRef;
+  }
+  const settings = selectProjectGroupingSettings(getClientSettings());
+  const logicalKey = deriveLogicalProjectKeyFromSettings(source, settings);
+  const primary = projects.find(
+    (project) =>
+      project.environmentId === primaryEnvironmentId &&
+      deriveLogicalProjectKeyFromSettings(project, settings) === logicalKey,
+  );
+  return primary ? scopeProjectRef(primary.environmentId, primary.id) : projectRef;
+}
