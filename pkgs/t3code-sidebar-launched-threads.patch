+
+export interface SidebarLaunchFamily {
+  readonly childKeys: readonly string[];
+  readonly collapsed: boolean;
+}
+
+export interface SidebarLaunchNesting<T> {
+  readonly threads: readonly T[];
+  readonly visibleThreads: readonly T[];
+  readonly familyByParentKey: ReadonlyMap<string, SidebarLaunchFamily>;
+  readonly childKeys: ReadonlySet<string>;
+}
+
+export function nestSidebarLaunchedThreads<
+  T extends Pick<SidebarThreadSummary, "environmentId" | "id" | "launchedFrom">,
+>(
+  threads: readonly T[],
+  input: {
+    readonly collapsedParentKeys: ReadonlySet<string>;
+    readonly routeThreadKey: string | null;
+    readonly sameGroup?: (parent: T, child: T) => boolean;
+  },
+): SidebarLaunchNesting<T> {
+  const keyOf = (thread: T) => scopedThreadKey(scopeThreadRef(thread.environmentId, thread.id));
+  const byKey = new Map(threads.map((thread) => [keyOf(thread), thread] as const));
+  const parentOf = (thread: T): T | undefined => {
+    const from = thread.launchedFrom;
+    if (from == null) return undefined;
+    const parent = byKey.get(scopedThreadKey(scopeThreadRef(from.environmentId, from.threadId)));
+    if (parent === undefined || parent === thread) return undefined;
+    return input.sameGroup === undefined || input.sameGroup(parent, thread) ? parent : undefined;
+  };
+  const rootKeyOf = (thread: T): string => {
+    const visited = new Set<T>([thread]);
+    let current = thread;
+    for (let parent = parentOf(current); parent !== undefined; parent = parentOf(current)) {
+      if (visited.has(parent)) return keyOf(thread);
+      visited.add(parent);
+      current = parent;
+    }
+    return keyOf(current);
+  };
+  const membersByRoot = new Map<string, T[]>();
+  for (const thread of threads) {
+    const rootKey = rootKeyOf(thread);
+    const members = membersByRoot.get(rootKey);
+    if (members === undefined) membersByRoot.set(rootKey, [thread]);
+    else members.push(thread);
+  }
+  if (membersByRoot.size === threads.length) {
+    return {
+      threads,
+      visibleThreads: threads,
+      familyByParentKey: new Map(),
+      childKeys: new Set(),
+    };
+  }
+  const ordered: T[] = [];
+  const visible: T[] = [];
+  const familyByParentKey = new Map<string, SidebarLaunchFamily>();
+  const childKeys = new Set<string>();
+  for (const [rootKey, members] of membersByRoot) {
+    const root = byKey.get(rootKey)!;
+    ordered.push(root);
+    visible.push(root);
+    const children = members.filter((member) => member !== root);
+    if (children.length === 0) continue;
+    const collapsed = input.collapsedParentKeys.has(rootKey);
+    familyByParentKey.set(rootKey, { childKeys: children.map(keyOf), collapsed });
+    for (const child of children) {
+      const childKey = keyOf(child);
+      childKeys.add(childKey);
+      ordered.push(child);
+      if (!collapsed || childKey === input.routeThreadKey) visible.push(child);
+    }
+  }
+  return { threads: ordered, visibleThreads: visible, familyByParentKey, childKeys };
+}
