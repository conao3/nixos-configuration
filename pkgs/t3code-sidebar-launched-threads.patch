diff --git a/apps/web/src/components/SidebarLaunchFamily.browser.test.tsx b/apps/web/src/components/SidebarLaunchFamily.browser.test.tsx
new file mode 100644
index 00000000..89ade704
--- /dev/null
+++ b/apps/web/src/components/SidebarLaunchFamily.browser.test.tsx
@@ -0,0 +1,70 @@
+import { createMemoryHistory } from "@tanstack/react-router";
+import { DEFAULT_CLIENT_SETTINGS } from "@t3tools/contracts/settings";
+import type * as Context from "effect/Context";
+import { expect, it, vi } from "vite-plus/test";
+import { page, userEvent } from "vite-plus/test/browser";
+
+import "~/index.css";
+
+import { AppRoot } from "~/AppRoot";
+import "~/components/ChatView";
+import { __setClientSettingsForTests } from "~/hooks/useSettings";
+import { getRouter } from "~/router";
+import {
+  ENVIRONMENT_ID,
+  installFakeEnvironment,
+  threadWithHistory,
+  type FakeDriver,
+} from "../../test/fakeEnvironment";
+import { render } from "../../test/render";
+
+vi.mock("../../../../packages/client-runtime/src/connection/driver.ts", async (importOriginal) => {
+  const [actual, { fakeDriver }, Layer] = await Promise.all([
+    importOriginal<{ readonly ConnectionDriver: Context.Key<unknown, FakeDriver> }>(),
+    import("../../test/fakeEnvironment"),
+    import("effect/Layer"),
+  ]);
+  return { ...actual, layer: Layer.succeed(actual.ConnectionDriver, fakeDriver) };
+});
+
+vi.mock(import("~/rpc/requestLatencyState"), async (original) => ({
+  ...(await original()),
+  trackRpcRequestSent: () => {},
+}));
+
+const rowThreadIds = () =>
+  [...document.querySelectorAll("[data-thread-item]")].map((row) =>
+    row.getAttribute("data-thread-item")?.split(":").at(-1),
+  );
+
+it("lists launched threads under their parent and folds them away", async () => {
+  const parent = threadWithHistory("parent", 1);
+  using _environment = installFakeEnvironment([
+    { ...threadWithHistory("first-child", 1), launchedFrom: parent.id },
+    threadWithHistory("other", 1),
+    parent,
+    { ...threadWithHistory("second-child", 1), launchedFrom: parent.id },
+  ]);
+  await page.viewport(1400, 900);
+  __setClientSettingsForTests({
+    ...DEFAULT_CLIENT_SETTINGS,
+    onboardingCompletedAt: "2026-01-01T00:00:00.000Z",
+  });
+  const router = getRouter(
+    createMemoryHistory({ initialEntries: [`/${ENVIRONMENT_ID}/${parent.id}`] }),
+  );
+  await router.load();
+  const container = document.createElement("div");
+  container.style.cssText = "height: 900px; width: 1400px;";
+  await using _app = await render(<AppRoot router={router} />, { container, router: false });
+
+  const hide = page.getByRole("button", { name: "Hide 2 launched threads" });
+  await expect.element(hide).toBeVisible();
+  const family = rowThreadIds().filter((id) => id !== "other");
+  expect(family).toEqual(["parent", "first-child", "second-child"]);
+  expect(document.querySelectorAll("[data-testid='sidebar-row-launch-child']")).toHaveLength(2);
+
+  await userEvent.click(hide);
+  await expect.element(page.getByRole("button", { name: "Show 2 launched threads" })).toBeVisible();
+  expect(rowThreadIds().filter((id) => id !== "other")).toEqual(["parent"]);
+});
