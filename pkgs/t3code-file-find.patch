diff --git a/apps/web/src/components/files/fileFind.ts b/apps/web/src/components/files/fileFind.ts
new file mode 100644
index 00000000..ae7cc65d
--- /dev/null
+++ b/apps/web/src/components/files/fileFind.ts
@@ -0,0 +1,81 @@
+import { registerCommands } from "../../shortcuts/dispatcher";
+
+export const FILE_FIND_HIGHLIGHT_NAME = "t3-file-find";
+export const FILE_FIND_ACTIVE_HIGHLIGHT_NAME = "t3-file-find-active";
+
+export function findTextRanges(root: Node, query: string, exclude: Node | null = null): Range[] {
+  if (query.length === 0) return [];
+  const needle = query.toLocaleLowerCase();
+  const document = root.ownerDocument ?? (root as Document);
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode: (node) =>
+      exclude?.contains(node) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT,
+  });
+  const ranges: Range[] = [];
+  for (let node = walker.nextNode(); node !== null; node = walker.nextNode()) {
+    const text = (node as Text).data;
+    const lowered = text.toLocaleLowerCase();
+    const haystack = lowered.length === text.length ? lowered : text;
+    const target = lowered.length === text.length ? needle : query;
+    for (let index = haystack.indexOf(target); index !== -1;) {
+      const range = document.createRange();
+      range.setStart(node, index);
+      range.setEnd(node, index + target.length);
+      ranges.push(range);
+      index = haystack.indexOf(target, index + target.length);
+    }
+  }
+  return ranges;
+}
+
+export function wrapFindIndex(index: number, total: number): number {
+  if (total <= 0) return 0;
+  return ((index % total) + total) % total;
+}
+
+function highlightsSupported(): boolean {
+  return typeof CSS !== "undefined" && "highlights" in CSS && typeof Highlight !== "undefined";
+}
+
+export function paintFindHighlights(ranges: readonly Range[], activeIndex: number): void {
+  if (!highlightsSupported()) return;
+  const active = ranges[activeIndex];
+  CSS.highlights.set(
+    FILE_FIND_HIGHLIGHT_NAME,
+    new Highlight(...ranges.filter((range) => range !== active)),
+  );
+  CSS.highlights.set(FILE_FIND_ACTIVE_HIGHLIGHT_NAME, new Highlight(...(active ? [active] : [])));
+}
+
+export function clearFindHighlights(): void {
+  if (!highlightsSupported()) return;
+  CSS.highlights.delete(FILE_FIND_HIGHLIGHT_NAME);
+  CSS.highlights.delete(FILE_FIND_ACTIVE_HIGHLIGHT_NAME);
+}
+
+export function isFileSurfaceActive(surface: HTMLElement | null): boolean {
+  const activeElement = document.activeElement;
+  return surface !== null && activeElement !== null && surface.contains(activeElement);
+}
+
+/** Claims the find shortcut while focus is inside `surface`, ahead of the thread find. */
+export function registerFileFindShortcut(
+  surface: () => HTMLElement | null,
+  onFind: (event: KeyboardEvent) => boolean | void,
+): () => void {
+  return registerCommands(
+    {
+      "chat.find": (event: KeyboardEvent) => {
+        if (onFind(event) === false) return false;
+        event.preventDefault();
+        event.stopPropagation();
+        return true;
+      },
+    },
+    {
+      capture: true,
+      when: (event) => event.isTrusted && isFileSurfaceActive(surface()),
+      context: () => ({ previewFocus: false }),
+    },
+  );
+}
