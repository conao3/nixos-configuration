index 00000000..6546b189
--- /dev/null
+++ b/apps/web/src/components/files/FileFindBar.tsx
@@ -0,0 +1,198 @@
+import { ChevronDownIcon, ChevronUpIcon, XIcon } from "lucide-react";
+import { useEffect, useRef, useState, type KeyboardEvent, type RefObject } from "react";
+
+import { cn } from "~/lib/utils";
+import { Button } from "../ui/button";
+import { InputGroup, InputGroupAddon, InputGroupInput } from "../ui/input-group";
+import {
+  clearFindHighlights,
+  findTextRanges,
+  paintFindHighlights,
+  registerFileFindShortcut,
+  wrapFindIndex,
+} from "./fileFind";
+
+/** Find in a file surface whose text is in the DOM (rendered markdown). */
+export function useFileFind(surfaceRef: RefObject<HTMLElement | null>) {
+  const [open, setOpen] = useState(false);
+  const [query, setQuery] = useState("");
+  const [activeIndex, setActiveIndex] = useState(0);
+  const [focusRequestId, setFocusRequestId] = useState(0);
+  const [ranges, setRanges] = useState<Range[]>([]);
+  const [bar, setBar] = useState<HTMLDivElement | null>(null);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- registers the find shortcut on the global keyboard dispatcher
+  useEffect(
+    () =>
+      registerFileFindShortcut(
+        () => surfaceRef.current,
+        () => {
+          setOpen(true);
+          setFocusRequestId((value) => value + 1);
+        },
+      ),
+    [surfaceRef],
+  );
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- searches the rendered DOM text and follows its mutations
+  useEffect(() => {
+    const surface = surfaceRef.current;
+    if (!open || !surface) {
+      setRanges([]);
+      return;
+    }
+    let frame: number | null = null;
+    const search = () => {
+      frame = null;
+      setRanges(findTextRanges(surface, query, bar));
+    };
+    search();
+    const observer = new MutationObserver((records) => {
+      if (records.every((record) => bar?.contains(record.target))) return;
+      if (frame === null) frame = requestAnimationFrame(search);
+    });
+    observer.observe(surface, { childList: true, subtree: true, characterData: true });
+    return () => {
+      observer.disconnect();
+      if (frame !== null) cancelAnimationFrame(frame);
+    };
+  }, [bar, open, query, surfaceRef]);
+
+  const currentIndex = wrapFindIndex(activeIndex, ranges.length);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- paints CSS highlights and scrolls the active match into view
+  useEffect(() => {
+    if (!open || ranges.length === 0) {
+      clearFindHighlights();
+      return;
+    }
+    paintFindHighlights(ranges, currentIndex);
+    ranges[currentIndex]?.startContainer.parentElement?.scrollIntoView({
+      block: "center",
+      inline: "nearest",
+    });
+  }, [currentIndex, open, ranges]);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- removes this surface's highlights when it unmounts
+  useEffect(() => clearFindHighlights, []);
+
+  return {
+    attachBar: setBar,
+    open,
+    query,
+    matchCount: ranges.length,
+    activeIndex: currentIndex,
+    focusRequestId,
+    onQueryChange: (next: string) => {
+      setQuery(next);
+      setActiveIndex(0);
+    },
+    onNext: () => setActiveIndex(currentIndex + 1),
+    onPrevious: () => setActiveIndex(currentIndex - 1),
+    onClose: () => {
+      setOpen(false);
+      clearFindHighlights();
+      surfaceRef.current?.focus({ preventScroll: true });
+    },
+  };
+}
+
+export function FileFindBar({ attachBar, ...props }: ReturnType<typeof useFileFind>) {
+  const inputRef = useRef<HTMLInputElement | null>(null);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- focuses and selects the input DOM node when the bar opens or the shortcut fires again
+  useEffect(() => {
+    if (!props.open) return;
+    inputRef.current?.focus();
+    inputRef.current?.select();
+  }, [
+    // oxlint-disable-next-line react/exhaustive-effect-dependencies -- Each find shortcut bumps the request id, so an open bar refocuses and reselects its query.
+    props.focusRequestId,
+    props.open,
+  ]);
+
+  if (!props.open) return null;
+
+  const hasQuery = props.query.length > 0;
+  const noResults = hasQuery && props.matchCount === 0;
+  const label = hasQuery
+    ? props.matchCount === 0
+      ? "0/0"
+      : `${props.activeIndex + 1}/${props.matchCount}`
+    : "";
+  const handleKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.nativeEvent.isComposing || event.nativeEvent.keyCode === 229) return;
+    if (event.key === "Enter") {
+      event.preventDefault();
+      event.stopPropagation();
+      if (event.shiftKey) props.onPrevious();
+      else props.onNext();
+    } else if (event.key === "Escape") {
+      event.preventDefault();
+      event.stopPropagation();
+      props.onClose();
+    }
+  };
+
+  return (
+    <div
+      ref={attachBar}
+      data-file-find-bar
+      className="absolute top-3 right-3 z-40 w-[min(22rem,calc(100%-1.5rem))]"
+    >
+      <InputGroup
+        variant="popover"
+        size="lg"
+        role="search"
+        aria-label="Find in file"
+        className="w-full"
+      >
+        <InputGroupInput
+          ref={inputRef}
+          type="search"
+          size="sm"
+          value={props.query}
+          aria-label="Find in file"
+          placeholder="Find in file"
+          maxLength={200}
+          spellCheck={false}
+          autoComplete="off"
+          onChange={(event) => props.onQueryChange(event.target.value)}
+          onKeyDown={handleKeyDown}
+        />
+        <InputGroupAddon align="inline-end" inset="pill">
+          <span
+            aria-live="polite"
+            className={cn(
+              "min-w-10 text-center text-xs tabular-nums",
+              noResults ? "text-destructive" : "text-muted-foreground",
+            )}
+          >
+            {label}
+          </span>
+          <Button
+            size="icon-xs"
+            variant="ghost"
+            aria-label="Previous match"
+            disabled={props.matchCount === 0}
+            onClick={props.onPrevious}
+          >
+            <ChevronUpIcon />
+          </Button>
+          <Button
+            size="icon-xs"
+            variant="ghost"
+            aria-label="Next match"
+            disabled={props.matchCount === 0}
+            onClick={props.onNext}
+          >
+            <ChevronDownIcon />
+          </Button>
+          <Button size="icon-xs" variant="ghost" aria-label="Close find" onClick={props.onClose}>
+            <XIcon />
+          </Button>
+        </InputGroupAddon>
+      </InputGroup>
+    </div>
+  );
+}
